PORT=5050
MONGO_URI=mongodb://localhost:27017/cinema_booking
JWT_SECRET=your_super_secret_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# PayPal: only the Sandbox is supported. The server refuses to start unless
# PAYPAL_ENV=sandbox. Get the client ID and secret from a Sandbox REST app at
# https://developer.paypal.com/dashboard/applications/sandbox
# (both empty until payments are set up, or both filled in).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the Sandbox webhook pointing at <your public URL>/payments/webhook
PAYPAL_WEBHOOK_ID=
# Optional: your Sandbox business account's merchant ID. When set, a payment
# only counts if PayPal says the money went to this account.
# PAYPAL_MERCHANT_ID=

# development: error responses include stack traces. Anything else (or unset): safe responses.
NODE_ENV=development

# Optional: frontend URLs allowed to call the API from a browser (comma-separated).
# Leave unset to allow any origin during development.
# CORS_ORIGIN=http://localhost:5173

# Optional: failed login/register attempts allowed per IP per 15 minutes (default 10)
# AUTH_RATE_LIMIT=10

# Optional: minutes an unpaid booking holds its seats, 1-60 (default 10)
# HOLD_MINUTES=10

# Optional: requests allowed per IP per 15 minutes across the whole API (default 300)
# API_RATE_LIMIT=300

# Optional: number of proxies in front of the app when hosted (e.g. 1 on Render/Heroku)
# TRUST_PROXY=1

# Optional: the cinemas' time zone (default Africa/Cairo). The demo seed
# plans showtimes in this local time.
# CINEMA_TZ=Africa/Cairo

# The booking assistant (Gemini). Without GEMINI_API_KEY the chat answers 503
# and everything else works. Create a key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional: the Gemini model (default gemini-3.5-flash), and the one a message
# uses when the first is busy (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Optional: model calls allowed per day across all users (default 200)
# AI_DAILY_REQUEST_CAP=200
# Optional: messages to the assistant per user per hour (default 30)
# AI_USER_MESSAGE_LIMIT=30

# Used by scripts/seedAdmin.js to create the admin account.
# ADMIN_PASSWORD: choose your own, at least 12 characters.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@cinema.com
ADMIN_PASSWORD=
