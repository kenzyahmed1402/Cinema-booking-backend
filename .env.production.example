# Settings for `npm run seed:prod`, which seeds the deployed database from
# your computer. Copy this file to .env.production (gitignored) and fill it in
# with an editor, not in the terminal. The server on Render doesn't read it:
# its settings go in Render's Environment tab.

# The deployed app's own database (not the one in .env), with its name before the "?"
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/cinemate-prod?retryWrites=true&w=majority

# Same value as on Render, so demo showtimes are planned in the cinemas' time
CINEMA_TZ=Africa/Cairo

# The admin account to create on the deployed app (password at least 12 characters)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@cinema.com
ADMIN_PASSWORD=
